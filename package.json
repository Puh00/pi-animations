{
  "name": "@puh00/pi-animations",
  "version": "1.0.1",
  "description": "Full-width terminal animations while Pi works",
  "license": "MIT AND BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/puh00/pi-animations.git"
  },
  "homepage": "https://github.com/puh00/pi-animations#readme",
  "bugs": {
    "url": "https://github.com/puh00/pi-animations/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "animation",
    "terminal"
  ],
  "files": [
    "index.ts",
    "animations/",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "verification.md"
  ],
  "type": "module",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@earendil-works/pi-tui": "^1.3.0",
    "typescript": "^5.9.3"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "test:pi": "python3 testdata/pty-check.py",
    "preview": "node --experimental-strip-types test/generate-preview.mjs",
    "bench": "node --experimental-strip-types test/benchmark.mjs",
    "typecheck": "tsc --noEmit --strict --target ES2022 --module NodeNext --moduleResolution NodeNext --allowImportingTsExtensions --skipLibCheck index.ts animations/*.ts"
  },
  "publishConfig": {
    "access": "public"
  }
}
